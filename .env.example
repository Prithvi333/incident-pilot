# IncidentPilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is already in .gitignore.

# ── MySQL Database ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=incidentpilot
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ── AWS (Bedrock + S3) ──
# Credentials are resolved via the Default Credential Provider Chain:
#   1. Environment variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
#   2. ~/.aws/credentials file
#   3. IAM instance role (EC2/ECS)
# Set these ONLY if you're not using ~/.aws/credentials:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1

# Bedrock model — must be an inference profile ID, not a raw model ID
BEDROCK_CHAT_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0

# S3 bucket for document uploads
AWS_S3_BUCKET=incident-pilot-docs

# ── JWT Authentication ──
# Base64-encoded HMAC-SHA256 key (min 256 bits / 32 bytes)
# Generate one with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_jwt_secret

# ── Qdrant Vector Store (optional) ──
QDRANT_HOST=localhost
QDRANT_PORT=6334
