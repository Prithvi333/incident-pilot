
# ==========================================
# MySQL Database
# ==========================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=incidentpilot
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Incident Application Database Credentials
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password


# ==========================================
# IncidentPilot Application
# ==========================================
INCIDENT_PORT=8080
LOG_FILE=logs/incidentpilot.log


# ==========================================
# Kafka
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DOCUMENT_INGESTION_TOPIC=incidentpilot.document-ingestion
KAFKA_PORT=9092


# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis
REDIS_PASSWORD=your_redis_password


# ==========================================
# Qdrant
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_TLS=false


# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=replace_with_a_secure_base64_encoded_secret
JWT_EXPIRATION_MS=86400000


# ==========================================
# AI Service
# ==========================================
AI_SERVICE_URL=http://localhost:8081

# ==========================================
# logstash
# ==========================================
LOGSTASH_HOST=incidentpilot-logstash:5044


# ==========================================
# CORS / WebSocket
# ==========================================
ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1:*,http://10.0.0.12
