
# ==========================================
# Ollama
# ==========================================
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest


# ==========================================
# AI Service
# ==========================================
SPRING_APPLICATION_NAME=ai
AI_PORT=8081
AI_SERVER_PORT=8081


# ==========================================
# Qdrant
# ==========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6334
QDRANT_COLLECTION=incident-pilot
QDRANT_INITIALIZE_SCHEMA=true


# ==========================================
# Kafka
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DOCUMENT_INGESTION_TOPIC=incidentpilot.document-ingestion
KAFKA_CONSUMER_CONTAINER_FACTORY=incidentDocumentKafkaListenerContainerFactory


# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=replace_with_a_secure_shared_secret
JWT_EXPIRATION_MS=86400000


# ==========================================
# RAG Document Chunking
# ==========================================
RAG_CHUNK_SIZE=300
RAG_MIN_CHUNK_SIZE=100
RAG_MIN_CHUNK_LENGTH_TO_EMBED=5
RAG_MAX_CHUNKS=10000
RAG_KEEP_SEPARATOR=true


# ==========================================
# Resilience4j Circuit Breaker
# ==========================================
AI_CB_SLIDING_WINDOW_SIZE=5
AI_CB_FAILURE_RATE_THRESHOLD=50
AI_CB_WAIT_DURATION=30s
AI_CB_HALF_OPEN_CALLS=2

# ==========================================
# logstash
# ==========================================
LOGSTASH_HOST=incidentpilot-logstash:5044


# ==========================================
# Kafka Consumer Configuration
# ==========================================
KAFKA_CONSUMER_GROUP_ID=incidentpilot-ai-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_TRUSTED_PACKAGES=com.incidentpilot.ai.event
