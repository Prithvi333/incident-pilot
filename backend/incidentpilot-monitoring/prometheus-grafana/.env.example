
# ==========================================
# Prometheus Configuration
# ==========================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d


# ==========================================
# Grafana Configuration
# ==========================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_password


# ==========================================
# Prometheus Backend Target
# ==========================================
BACKEND_HOST=your-backend-service
BACKEND_PORT=8080


# ==========================================
# Prometheus AI Service Target
# ==========================================
AI_HOST=your-ai-service
AI_PORT=8081


# ==========================================
# Prometheus Ingestion Service Target
# ==========================================
INGESTION_HOST=your-ingestion-service
INGESTION_PORT=8082
