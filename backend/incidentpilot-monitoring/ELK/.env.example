
# ==========================================
# Elasticsearch Credentials
# ==========================================
ELASTIC_PASSWORD=replace_with_elasticsearch_password


# ==========================================
# Kibana System User
# ==========================================
KIBANA_PASSWORD=replace_with_kibana_password


# ==========================================
# Kibana Encryption Keys (Minimum 32 Characters)
# ==========================================
KIBANA_ENCRYPTION_KEY=replace_with_32_character_encryption_key
KIBANA_SECURITY_KEY=replace_with_32_character_security_key
KIBANA_REPORTING_KEY=replace_with_32_character_reporting_key


# ==========================================
# Logstash Credentials
# ==========================================
LOGSTASH_USERNAME=logstash_internal
LOGSTASH_PASSWORD=replace_with_logstash_password


# ==========================================
# Elasticsearch Connection
# ==========================================
ELASTICSEARCH_HOST=http://elasticsearch:9200
